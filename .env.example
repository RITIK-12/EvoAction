# Crusoe Managed Inference (OpenAI-compatible). Never commit the real .env.
CRUSOE_API_KEY=
CRUSOE_API_BASE=https://api.inference.crusoecloud.com/v1
# Live IDs confirmed by scripts/preflight.py (GET /v1/models). Near-miss IDs are resolved automatically.
CRUSOE_REASONING_MODEL=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B
CRUSOE_VISION_MODEL=nvidia/Nemotron-3-Nano-Omni-Reasoning-30B-A3B

# Budgets (hard stops; denials are persisted as budget decisions)
MAX_NEMOTRON_CALLS=24
MAX_VISION_CALLS=48
MAX_AGENT_TASKS=12
MAX_CANDIDATE_EXPERIMENTS=2
MAX_RETRIES_PER_CALL=1
MAX_SPEND_USD=35
RESERVED_TEST_VISION_CALLS=9
REQUEST_TIMEOUT_SECONDS=180
