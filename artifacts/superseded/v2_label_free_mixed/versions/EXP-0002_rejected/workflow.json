    "thinking": false,
    "max_tokens": 2048,
    "temperature": 0.2,
    "allow_insert": true,
    "allow_delete": true
   },
   "when": "always"
  },
  {
   "id": "merge",
   "operator": "merge_filter_segments",
   "depends_on": [
