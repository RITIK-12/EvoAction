   ],
   "params": {
    "select": "near_hints",
    "window_sec": 2.0,
    "local_hz": 2.0,
    "max_windows": 4,
    "include_unmatched_hints": false,
    "tile_px": 224,
    "confidence_threshold": 0.7
   },
   "when": "has_hints"
  },
  {
   "id": "refine",
   "operator": "refine_intervals",
   "depends_on": [
    "annotate",
    "inspect"
   ],
   "params": {
