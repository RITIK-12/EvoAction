   "params": {
    "sampling_hz": 2.0,
    "tile_px": 224,
    "frames_per_sheet": 20,
    "cols": 5
   },
   "when": "always"
  },
  {
   "id": "annotate",
   "operator": "initial_annotate",
   "depends_on": [
    "sample"
   ],
   "params": {
    "prompt": "prompt.md",
    "thinking": false,
    "max_tokens": 8192
   },
   "when": "always"
  },
  {
   "id": "hints",
   "operator": "state_hint_detection",
   "depends_on": [
    "sample"
   ],
   "params": {
    "signals": [
     "gripper",
     "eef_pause"
    ],
    "min_gap_sec": 0.8,
    "pause_speed_quantile": 0.15,
    "min_pause_sec": 0.3
   },
   "when": "has_telemetry"
  },
  {
   "id": "inspect",
   "operator": "inspect_transition_windows",
