   "params": {
    "min_duration_sec": 0.4,
    "max_gap_sec": 1.0,
    "tile_full_episode": true,
    "merge_same_label": false
   },
   "when": "always"
  },
  {
   "id": "export",
   "operator": "validate_export",
   "depends_on": [
    "merge"
   ],
   "params": {},
   "when": "always"
  }
 ],
